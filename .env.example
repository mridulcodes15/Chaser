# Copy this file to .env and fill it in. Never commit .env.
# Only the PayPal and Groq values are needed to run locally.

# --- PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook in your sandbox app. Without it, webhooks are refused and the reconciler does the work.
PAYPAL_WEBHOOK_ID=
# auto (default), invoicing or orders
PAYMENT_PROVIDER=
# Leave unset. Chaser refuses to start if this is anything but the sandbox URL.
PAYPAL_BASE_URL=

# --- AI ---
# groq (default). anthropic is a stub that reports "not configured".
LLM_PROVIDER=
GROQ_API_KEY=
# Required, no default. Pick a model from console.groq.com/docs/models
GROQ_MODEL=
# Base wait in ms when rate limited. Default 1000.
LLM_BACKOFF_BASE_MS=

# --- App ---
# Default 3000
PORT=
# The address buyers use. Default http://localhost:PORT, or Render's own URL on Render.
PUBLIC_BASE_URL=
# Set by Render automatically. Leave unset elsewhere.
RENDER_EXTERNAL_URL=
# Protects the dashboard with HTTP Basic auth, with any username. Set this before deploying.
ADMIN_PASSWORD=
# Default data/chaser.sqlite
DATABASE_PATH=
# development or production
NODE_ENV=
# true seeds demo data when the database is empty
SEED_DEMO=
# true enables the simulate-paid dev tool. Always off when NODE_ENV=production.
DEV_TOOLS=

# --- Limits and collections rules (defaults shown in README) ---
MAX_INVOICE_AMOUNT=
MAX_LINE_ITEMS=
LARGE_AMOUNT_THRESHOLD=
VERY_OVERDUE_DAYS=
RECONCILE_INTERVAL_SECONDS=
COLLECTIONS_INTERVAL_MINUTES=
